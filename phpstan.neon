# PHPStan configuration — production level matching Aggressive Apparel.

parameters:
	level: 8
	paths:
		- aggressive-blocks.php
		- includes/
		- src/

	bootstrapFiles:
		- tests/phpstan-bootstrap.php

	scanFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php

	phpVersion: 80200

	# WordPress stubs declare optimistic types. PHPStan 2 treats those
	# docblocks as certain and then reports every defensive is_string()/
	# is_array() guard as redundant. Acting on that would delete runtime
	# protection. Same trade-off as Aggressive Apparel.
	treatPhpDocTypesAsCertain: false

	ignoreErrors:
		-
			identifier: missingType.iterableValue

	universalObjectCratesClasses:
		- WP_Post
		- WP_Term
		- WP_User
		- WP_Comment
		- WP_Query
		- WP_Block_Type
		- stdClass
