{
  "name": "aggressive-blocks",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Gutenberg blocks extracted from Aggressive Apparel",
  "author": "The Aggressive Network, LLC",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "wordpress",
    "gutenberg",
    "blocks"
  ],
  "homepage": "https://github.com/TheAggressive/aggressive-blocks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheAggressive/aggressive-blocks.git"
  },
  "bugs": {
    "url": "https://github.com/TheAggressive/aggressive-blocks/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/wordpress__block-editor": "^15.0.6",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@wordpress/api-fetch": "^7.53.0",
    "@wordpress/block-editor": "^16.2.0",
    "@wordpress/blocks": "^15.26.0",
    "@wordpress/components": "^37.0.0",
    "@wordpress/compose": "^8.6.0",
    "@wordpress/core-data": "^7.54.0",
    "@wordpress/data": "^10.53.0",
    "@wordpress/element": "^8.5.0",
    "@wordpress/env": "^10.39.0",
    "@wordpress/eslint-plugin": "^25.9.0",
    "@wordpress/hooks": "^4.53.0",
    "@wordpress/html-entities": "^4.55.0",
    "@wordpress/i18n": "^6.26.0",
    "@wordpress/icons": "^15.4.0",
    "@wordpress/interactivity": "^6.53.0",
    "@wordpress/scripts": "^33.0.0",
    "@wordpress/stylelint-config": "^24.2.0",
    "concurrently": "^9.2.4",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "postcss-lightningcss": "^1.1.1",
    "postcss-nested": "^7.0.2",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "semantic-release": "^25.0.9",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "yaml": "2.9.1"
  },
  "scripts": {
    "build": "rm -rf build && concurrently 'pnpm build:blocks' 'pnpm build:interactivity' 'pnpm build:modules' 'pnpm build:icons' 'pnpm build:debug' && pnpm build:manifest",
    "build:manifest": "wp-scripts build-blocks-manifest --input=build --output=build/blocks-manifest.php",
    "build:blocks": "wp-scripts build --config webpack.config.mjs --source-path=./src/blocks --output-path=./build/blocks && pnpm sync:php:blocks",
    "build:interactivity": "wp-scripts build --config webpack.config.mjs --source-path=./src/blocks-interactivity --output-path=./build/blocks-interactivity --experimental-modules && pnpm sync:php:interactivity",
    "sync:php:blocks": "find src/blocks \\( -name 'render.php' -o -name 'block.json' -o -name 'legal-entity-presets.json' \\) | while read f; do dest=\"build/${f#src/}\"; mkdir -p \"$(dirname $dest)\"; cp \"$f\" \"$dest\"; done",
    "sync:php:interactivity": "find src/blocks-interactivity \\( -name 'render.php' -o -name 'block.json' -o -name 'motion-variants.json' \\) | while read f; do dest=\"build/${f#src/}\"; mkdir -p \"$(dirname $dest)\"; cp \"$f\" \"$dest\"; done",
    "build:modules": "wp-scripts build --config webpack.modules.config.mjs",
    "build:icons": "node bin/build-icons.mjs",
    "build:debug": "mkdir -p build/styles && cp src/blocks-interactivity/debug-shared/style.css build/styles/debug-overlays.css",
    "start": "concurrently 'pnpm start:blocks' 'pnpm start:interactivity' 'pnpm watch:icons'",
    "start:blocks": "wp-scripts start --config webpack.config.mjs --source-path=./src/blocks --output-path=./build/blocks",
    "start:interactivity": "wp-scripts start --config webpack.config.mjs --source-path=./src/blocks-interactivity --output-path=./build/blocks-interactivity --experimental-modules",
    "watch:icons": "node bin/build-icons.mjs --watch",
    "format": "pnpm format:fix",
    "format:fix": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore \"./**/*.{js,jsx,json,ts,tsx,yml,yaml}\"",
    "format:check": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore \"./**/*.{js,jsx,json,ts,tsx,yml,yaml}\"",
    "lint:files": "bash bin/check-file-length.sh",
    "lint:shell": "AA_SHELLCHECK_NATIVE=1 bash bin/check-shell.sh",
    "lint:js": "eslint src bin --ext .js,.jsx,.ts,.tsx,.mjs --max-warnings 0",
    "lint:js:fix": "eslint src bin --ext .js,.jsx,.ts,.tsx,.mjs --fix",
    "lint:css": "stylelint 'src/blocks/**/*.css' 'src/blocks-interactivity/**/*.css'",
    "lint:css:fix": "stylelint 'src/blocks/**/*.css' 'src/blocks-interactivity/**/*.css' --fix",
    "lint:php": "composer lint:php",
    "lint:php:fix": "composer lint:php:fix",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "lint:commit": "commitlint --edit",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.e2e.json",
    "pretest": "pnpm run build:icons",
    "test": "pnpm run test:js && pnpm run test:tools && pnpm run test:php",
    "test:js": "wp-scripts test-unit-js --passWithNoTests",
    "test:tools": "node bin/ci/contracts.test.mjs && node --test bin/ci/classify-changes.test.mjs bin/ci/pr-policy.test.mjs bin/ci/release-summary.test.mjs bin/release/verify-package.test.mjs bin/check-file-length.test.mjs bin/check-shell.test.mjs bin/i18n/validate-po.test.mjs bin/i18n/lint-placeholders.test.mjs bin/wp-env/check.test.mjs && node bin/ci/contracts.mjs && node bin/lib/icon-build.test.mjs",
    "test:php": "bash bin/phpunit.sh --testdox",
    "test:unit": "bash bin/phpunit.sh --testsuite=unit --testdox",
    "test:integration": "bash bin/phpunit.sh --testsuite=integration --testdox",
    "test:security": "bash bin/phpunit.sh --testsuite=security --testdox",
    "test:accessibility": "bash bin/phpunit.sh --testsuite=accessibility --testdox",
    "test:performance": "bash bin/phpunit.sh --testsuite=performance --testdox",
    "analyse:php": "pnpm run phpstan",
    "phpstan": "XDEBUG_MODE=off ./vendor/bin/phpstan analyse --memory-limit=2G --verbose",
    "composer:verify": "composer validate --strict && composer install --dry-run --no-interaction --no-scripts",
    "i18n": "bash bin/i18n/all.sh",
    "i18n:pot": "bash bin/i18n/pot.sh",
    "i18n:sync": "bash bin/i18n/sync.sh",
    "i18n:compile": "bash bin/i18n/compile.sh",
    "i18n:check": "bash bin/i18n/check.sh",
    "plugin-zip": "wp-scripts plugin-zip",
    "package": "pnpm run build && bash bin/package.sh",
    "prepare": "husky",
    "qa": "bash bin/ci/node.sh qa:local:pinned",
    "qa:local:pinned": "bash bin/ci/verify.sh",
    "qa:ci": "pnpm run ci:verify",
    "qa:fast": "bash bin/ci/node.sh qa:fast:pinned",
    "qa:fast:pinned": "bash bin/ci/verify-fast.sh",
    "qa:dev": "pnpm run i18n:check && pnpm run composer:verify && pnpm run test && pnpm run lint:js && pnpm run typecheck && pnpm run lint:css && pnpm run lint:php && pnpm run phpstan",
    "ci:doctor": "node bin/ci/doctor.mjs",
    "ci:frontend": "pnpm ci:doctor && pnpm lint:files && pnpm lint:shell && pnpm lint:js && pnpm typecheck && pnpm lint:css && pnpm format:check && pnpm test:js && pnpm test:tools && pnpm lint:pkg-json && pnpm audit --prod --audit-level high",
    "ci:i18n": "pnpm ci:doctor && bash bin/ci/i18n.sh",
    "ci:build": "pnpm ci:doctor && pnpm build",
    "ci:env:reset": "bash bin/ci/reset-wp-env.sh",
    "ci:env:stop": "bash bin/ci/stop-wp-env.sh",
    "ci:env:beta": "bash bin/wp-env/update-beta-channel.sh",
    "ci:env:check": "bash bin/ci/check-wp-env.sh",
    "ci:php": "pnpm ci:doctor && bash bin/ci/php.sh",
    "ci:php:forward": "pnpm ci:doctor && bash bin/ci/php-forward.sh",
    "ci:package": "pnpm ci:doctor && bash bin/ci/package.sh",
    "ci:artifact": "pnpm ci:doctor && bash bin/ci/artifact.sh",
    "ci:browser:install": "playwright install chromium",
    "ci:e2e": "pnpm ci:doctor && bash bin/ci/e2e.sh",
    "ci:e2e:beta": "pnpm ci:doctor && CI=1 WP_BASE_URL=http://localhost:9930 playwright test",
    "ci:verify": "bash bin/ci/node.sh ci:verify:pinned",
    "ci:verify:pinned": "bash bin/ci/verify.sh",
    "ci:wp-env": "wp-env",
    "test:e2e": "playwright test",
    "test:e2e:ci": "bash bin/ci/node.sh test:e2e:pinned",
    "test:e2e:pinned": "pnpm ci:build && pnpm ci:browser:install && pnpm ci:e2e",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,json,yml,yaml}": "prettier --write"
  }
}
