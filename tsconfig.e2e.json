{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "tests/e2e/**/*.ts",
    "tests/integration/**/*.ts",
    "tests/visual/**/*.ts",
    "playwright.config.ts",
    "playwright.integration.config.ts",
    "playwright.visual.config.ts"
  ]
}
